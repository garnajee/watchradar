# Docker image version. Use "latest" or a published release such as "1.2.0".
WATCHRADAR_VERSION=latest

# Generate each secret with: openssl rand -hex 32
# Keep DB_PASSWORD hexadecimal: it is embedded in PostgreSQL's connection URL.
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_JWT_REFRESH_SECRET

# Never rotate this value after setup: it encrypts the Jellyfin API key.
ENCRYPTION_KEY=CHANGE_ME_ENCRYPTION_KEY

# Public HTTPS origin handled by your reverse proxy, without a trailing slash.
FRONTEND_ORIGIN=https://watchradar.example.com

# Plain HTTP endpoint exposed to your reverse proxy.
WATCHRADAR_BIND_ADDRESS=0.0.0.0
WATCHRADAR_HTTP_PORT=8080

# The user-managed reverse proxy is the only proxy in front of WatchRadar.
TRUST_PROXY_HOPS=1
COOKIE_SECURE=true

# Optional bootstrap values. Leave either value empty to configure it in the UI.
# A key stored here is visible to Docker; a key entered in Administration is
# encrypted in PostgreSQL instead.
JELLYFIN_TLS_REJECT_UNAUTHORIZED=true
JELLYFIN_URL=
JELLYFIN_API_KEY=

LOG_LEVEL=info
