# PostgreSQL
DB_PASSWORD=replace-with-a-long-random-hexadecimal-password
DB_PASSWORD_URLENCODED=replace-with-the-same-password-percent-encoded
# Used by the backend when it runs outside Docker.
DATABASE_URL=postgresql://watchradar:replace-with-the-same-password@127.0.0.1:5432/watchradar
POSTGRES_HOST_PORT=5432

# 32+ random characters for the access-token signature.
JWT_SECRET=replace-with-openssl-rand-hex-32
# Kept distinct for the seamless upgrade of legacy refresh cookies.
JWT_REFRESH_SECRET=replace-with-another-openssl-rand-hex-32

# Exactly 32 bytes represented as 64 hexadecimal characters
ENCRYPTION_KEY=replace-with-openssl-rand-hex-32

# Public HTTPS origin handled by your reverse proxy, without a trailing slash
FRONTEND_ORIGIN=https://watchradar.example.com

# Internal HTTP endpoint exposed for the reverse proxy
WATCHRADAR_BIND_ADDRESS=0.0.0.0
WATCHRADAR_HTTP_PORT=8080

# There are two proxies in production: the public reverse proxy and WatchRadar's Nginx.
TRUST_PROXY_HOPS=2
COOKIE_SECURE=true

# Keep true in production. Set false only for a trusted self-signed Jellyfin server.
JELLYFIN_TLS_REJECT_UNAUTHORIZED=true

# Required for the initial administrator login. Must be reachable from the backend container.
JELLYFIN_URL=https://jellyfin.example.com

LOG_LEVEL=info
